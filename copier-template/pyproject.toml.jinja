[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = "Install a packaged Codex personal local marketplace."
authors = [{ name = "Anonymous" }]
requires-python = ">=3.12,<4.0"
dependencies = ["marketplace-installer>=0.1.1,<0.2.0"]

[project.scripts]
{{ project_slug }} = "{{ package_name }}.__main__:main"

[tool.poetry]
packages = [{ include = "{{ package_name }}", from = "src" }]
include = [
  { path = "src/{{ package_name }}/resources/**", format = ["sdist", "wheel"] },
]

[tool.poetry.group.dev.dependencies]
pre-commit = "^4.0"
pytest = "^8.0"
ruff = "^0.12.0"
rumdl = "^0.2.0"

[tool.pytest.ini_options]
testpaths = ["tests"]

[tool.ruff]
target-version = "py312"
extend-exclude = ["src/{{ package_name }}/resources/"]

[build-system]
requires = ["poetry-core>=2.0.0,<3.0.0"]
build-backend = "poetry.core.masonry.api"
