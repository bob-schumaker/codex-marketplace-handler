{
  "$id": "https://example.invalid/router-plugin-mcp-launch-contract.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MCP package-backed launch contract",
  "type": "object",
  "required": ["schema_version", "server_id", "transport", "command", "python_version", "package_index", "package_name", "entrypoint", "forbidden_arg_fragments"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1, 2, 3]},
    "server_id": {"type": "string", "minLength": 1},
    "transport": {"const": "stdio"},
    "command": {"const": "uvx"},
    "python_version": {"type": "string", "minLength": 1},
    "package_index": {"type": "string", "minLength": 1},
    "package_name": {"type": "string", "minLength": 1},
    "entrypoint": {"type": "string", "minLength": 1},
    "extra_args": {"type": "array", "items": {"type": "string"}},
    "forbidden_arg_fragments": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "environment": {"type": "object", "additionalProperties": {"type": "string"}},
    "environment_authority": {"enum": ["config", "native_descriptor", "legacy_empty"]},
    "package_version": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": 1}}},
      "then": {
        "not": {
          "anyOf": [
            {"required": ["environment"]},
            {"required": ["environment_authority"]},
            {"required": ["package_version"]}
          ]
        }
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": 2}}},
      "then": {
        "required": ["environment"],
        "not": {"required": ["package_version"]}
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": 3}}},
      "then": {
        "required": ["environment", "environment_authority", "package_version"],
        "properties": {"environment_authority": {"const": "config"}}
      }
    }
  ],
  "additionalProperties": false
}
